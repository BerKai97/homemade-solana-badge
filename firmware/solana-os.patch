 #include "freertos/FreeRTOS.h"
 #include "freertos/task.h"
@@ -15,11 +16,66 @@ static const char *TAG = "bsp_buttons";
 #define TCA9534_REG_CONFIG  3
 #define POLL_MS             50
 
-static i2c_master_dev_handle_t s_tca;
-static SemaphoreHandle_t s_irq;
 static bsp_btn_cb_t s_cb;
 static volatile uint32_t s_pressed;
 
+#if CONFIG_BSP_BOARD_DIY
+// Each button pulls its GPIO to GND. Polled; a change counts once two reads
+// POLL_MS apart agree (debounce).
+#define DIY_POLL_MS 15
+
+static const int s_gpios[BOARD_BTN_COUNT] = BOARD_BTN_GPIOS;
+
+static uint32_t read_gpios(void)
+{
+    uint32_t pressed = 0;
+    for (int i = 0; i < BOARD_BTN_COUNT; i++) {
+        if (!gpio_get_level(s_gpios[i])) {
+            pressed |= 1u << i;
+        }
+    }
+    if (!gpio_get_level(BOARD_BOOT_BTN)) {
+        pressed |= BSP_BTN_BOOT;
+    }
+    return pressed;
+}
+
+static void diy_task(void *arg)
+{
+    uint32_t last = s_pressed;
+    for (;;) {
+        vTaskDelay(pdMS_TO_TICKS(DIY_POLL_MS));
+        uint32_t now = read_gpios();
+        if (now == last && now != s_pressed) {
+            uint32_t changed = now ^ s_pressed;
+            s_pressed = now;
+            if (s_cb) {
+                s_cb(now, changed);
+            }
+        }
+        last = now;
+    }
+}
+
+esp_err_t bsp_buttons_start(bsp_btn_cb_t cb)
+{
+    s_cb = cb;
+    uint64_t mask = BIT64(BOARD_BOOT_BTN);
+    for (int i = 0; i < BOARD_BTN_COUNT; i++) {
+        mask |= BIT64(s_gpios[i]);
+    }
+    gpio_config_t io = { .pin_bit_mask = mask, .mode = GPIO_MODE_INPUT, .pull_up_en = GPIO_PULLUP_ENABLE };
+    ESP_RETURN_ON_ERROR(gpio_config(&io), TAG, "gpio");
+    vTaskDelay(pdMS_TO_TICKS(2));           // let the pull-ups settle
+    s_pressed = read_gpios();
+    xTaskCreate(diy_task, "buttons", 2048, NULL, 5, NULL);
+    return ESP_OK;
+}
+
+#else
+static i2c_master_dev_handle_t s_tca;
+static SemaphoreHandle_t s_irq;
+
 static void IRAM_ATTR tca_isr(void *arg)
 {
     BaseType_t woken = pdFALSE;
@@ -94,6 +150,8 @@ esp_err_t bsp_buttons_start(bsp_btn_cb_t cb)
     return ESP_OK;
 }
 
+#endif
+
 uint32_t bsp_buttons_get(void)
 {
     return s_pressed;
