+# Solana OS, breadboard build without a microSD card (sdkconfig.diy), 16 MB flash.
+# Name,     Type, SubType,  Offset,   Size
+nvs,        data, nvs,      0x9000,   0x6000
+otadata,    data, ota,      0xF000,   0x2000
+phy_init,   data, phy,      0x11000,  0x1000
+ota_0,      app,  ota_0,    0x20000,  0x400000
+ota_1,      app,  ota_1,    0x420000, 0x400000
+# storage: used raw for store apps' compiled code (main/lua/lua_xip.c), two
+# 1 MB slots: the app running and the one before it.
+storage,    data, fat,      0x820000, 0x200000
