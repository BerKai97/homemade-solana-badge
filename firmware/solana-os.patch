+# (components/bsp/bsp_sd_flash.c).
+appfs,      data, fat,      0xA20000, 0x5E0000
diff --git a/sdkconfig.diy b/sdkconfig.diy
new file mode 100644
index 0000000..3a7e016
--- /dev/null
+++ b/sdkconfig.diy
@@ -0,0 +1,25 @@
+# The breadboard build (components/bsp/Kconfig, BSP_BOARD_DIY), on top of sdkconfig.defaults:
+#   idf.py -B build-diy -D SDKCONFIG=build-diy/sdkconfig \
+#          -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.diy" build flash monitor
+CONFIG_BSP_BOARD_DIY=y
+# No badge server until "server <url>" sets one: Solana's is for the conference badges.
+CONFIG_SOLANA_OS_SERVER_URL=""
+# No microSD: /sdcard is a FAT volume in the internal flash's appfs partition.
+CONFIG_BSP_SD_INTERNAL_FLASH=y
+CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-diy.csv"
+# XPT2046 touch on the display: T_CS on GPIO6, T_IRQ not wired (polled); see BSP_TOUCH_* in components/bsp/Kconfig.
+CONFIG_BSP_TOUCH_XPT2046=y
+CONFIG_BSP_TOUCH_IRQ=-1
+# The ESP32-C5-WROOM-1 N16R8 has 8 MB of quad PSRAM: malloc() uses it for big
+# blocks, and mbedTLS takes all its buffers from it, so a TLS handshake no
+# longer needs ~35 KB of internal RAM. A module without PSRAM still boots.
+CONFIG_SPIRAM=y
+CONFIG_SPIRAM_MODE_QUAD=y
+CONFIG_SPIRAM_SPEED_80M=y
+CONFIG_SPIRAM_USE_MALLOC=y
+CONFIG_SPIRAM_IGNORE_NOTFOUND=y
+CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
+# ESP-IDF's flash driver, not the ROM's (sdkconfig.defaults): after a write the C5 ROM
+# invalidates every cache page whose MMU entry has the same page number, PSRAM's too, so
+# an NVS write (flash pages 0-1) threw away cached PSRAM pages 0-1, the start of the heap.
+CONFIG_SPI_FLASH_ROM_IMPL=n
