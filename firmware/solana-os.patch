+// A copy of JSON with every integer beyond Lua's 32 bits in quotes ("5000000000"):
+// this badge's Lua has 32-bit integers and floats. NULL: no memory (use it as is).
+static char *quote_big_ints(const char *in)
+{
+    size_t len = strlen(in);
+    char *out = malloc(len + len / 4 + 16), *o = out;
+    size_t room = len + len / 4 + 15;
+    bool str = false, esc = false;
+    if (!out) {
+        return NULL;
+    }
+    for (const char *p = in; *p;) {
+        if (str) {
+            str = esc || *p != '"';
+            esc = !esc && *p == '\\';
+            *o++ = *p++;
+            continue;
+        }
+        if (*p == '"') {
+            str = true;
+            *o++ = *p++;
+            continue;
+        }
+        if ((*p == '-' || (*p >= '0' && *p <= '9'))) {
+            const char *q = p + (*p == '-');
+            while (*q >= '0' && *q <= '9') {
+                q++;
+            }
+            bool integer = *q != '.' && *q != 'e' && *q != 'E';
+            size_t digits = (size_t)(q - p) - (*p == '-');
+            bool big = integer && (digits > 10 || (digits == 10 && strncmp(p + (*p == '-'), "2147483647", 10) > 0));
+            size_t n = (size_t)(q - p);
+            if (big && (size_t)(o - out) + n + 2 <= room) {
+                *o++ = '"';
+                memcpy(o, p, n);
+                o += n;
+                *o++ = '"';
+                p = q;
+                continue;
+            }
+            memcpy(o, p, n);
+            o += n;
+            p = q;
+            continue;
+        }
+        *o++ = *p++;
+    }
+    *o = 0;
+    return out;
+}
