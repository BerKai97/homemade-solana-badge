+esp_err_t os_http_upload(const char *url, const char *bearer, const char *path, const void *data, size_t len,
+                         const char *filename, char *resp, size_t cap, int *status)
+{
+    upload_t up = { .data = data, .len = len, .name = filename };
+    *status = 0;
+    if (cap) {
+        resp[0] = 0;
+    }
+    if (path) {
+        struct stat st;
+        if (stat(path, &st) != 0 || !S_ISREG(st.st_mode) || !(up.f = fopen(path, "rb"))) {
+            return ESP_ERR_NOT_FOUND;
+        }
+        up.len = st.st_size;
+    }
+    if (up.len > OS_HTTP_UPLOAD_MAX || strpbrk(filename, "\"\r\n")) {
+        if (up.f) {
+            fclose(up.f);
+        }
+        return ESP_ERR_INVALID_SIZE;
+    }
+    esp_err_t err = request("POST", url, bearer, NULL, &up, resp, cap, status);
+    if (up.f) {
+        fclose(up.f);
+    }
+    return err;
+}
