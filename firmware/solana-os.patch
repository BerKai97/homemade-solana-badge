+#if CONFIG_BSP_BOARD_DIY
+// A breadboard's dev board often has two USB ports: the USB-to-UART chip's
+// (UART0, the REPL) and the chip's own (USB Serial/JTAG), which only got the
+// output. Lines typed on the second run here too, echoed, without a prompt.
+static TaskHandle_t s_usb_task;
+
+static void usb_console_task(void *arg)
+{
+    static char line[512];
+    size_t n = 0;
+    for (;;) {
+        uint8_t c;
+        if (usb_serial_jtag_read_bytes(&c, 1, portMAX_DELAY) <= 0) {
+            continue;
+        }
+        if (c == '\r' || c == '\n') {
+            if (n) {
+                usb_serial_jtag_write_bytes("\r\n", 2, 0);
+                line[n] = 0;
+                n = 0;
+                int ret;
+                if (esp_console_run(line, &ret) == ESP_ERR_NOT_FOUND) {
+                    printf("unknown command (help lists them)\n");
+                }
+            }
+        } else if (c == 0x7f || c == '\b') {
+            if (n) {
+                n--;
+                usb_serial_jtag_write_bytes("\b \b", 3, 0);
+            }
+        } else if (c >= 0x20 && n < sizeof(line) - 1) {
+            line[n++] = (char)c;
+            usb_serial_jtag_write_bytes(&c, 1, 0);
+        }
+    }
+}
+
+static void usb_console_start(void)
+{
+    usb_serial_jtag_driver_config_t cfg = USB_SERIAL_JTAG_DRIVER_CONFIG_DEFAULT();
+    cfg.rx_buffer_size = 4 * 1024;          // a whole lua recv block, while this task waits for the CPU
+    if (usb_serial_jtag_driver_install(&cfg) != ESP_OK) {
+        ESP_LOGW(TAG, "no console on the native USB port");
+        return;
+    }
+    usb_serial_jtag_vfs_use_driver();       // the output it already gets goes through the driver now
+    xTaskCreate(usb_console_task, "console_usb", 5 * 1024, NULL, 2, &s_usb_task);
+}
+#endif
