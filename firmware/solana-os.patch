+        strlcpy(name, slash ? slash + 1 : rel, sizeof(name));
+        struct stat st;
+        fail = stat(file, &st) != 0 || !S_ISREG(st.st_mode) ? "not found"
+             : st.st_size > OS_HTTP_UPLOAD_MAX ? "file over 2 MB" : NULL;
+    }
+    luaL_argcheck(L, lua_pkg_valid_path(name) && !strchr(name, '/'), 1, "name: a plain lowercase filename");
+    char key[WALLET_IPFS_KEY_MAX + 1];
+    if (!fail && !wallet_ipfs_key(key, sizeof(key))) {
+        fail = "no IPFS key: wallet ipfs key <token> on the console";
