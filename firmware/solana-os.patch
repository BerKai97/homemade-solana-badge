     return err;
 }
 
+// Uploads: the bytes go to fetch() as a FormData part; the answer as a request's.
+// (Sent once: an upload over 30 s gives up.)
+EM_JS(int, http_js_upload, (const char *url, const char *bearer, const uint8_t *data, int len, const char *name), {
+    const id = (Module.httpNext = (Module.httpNext || 0) + 1);
+    const req = { done: false, status: 0, text: "", failed: false };
+    (Module.http = Module.http || new Map()).set(id, req);
+    const form = new FormData();
+    form.append("file", new Blob([HEAPU8.slice(data, data + len)], { type: "application/octet-stream" }),
+                UTF8ToString(name));
+    const headers = {};
+    if (bearer) headers["Authorization"] = "Bearer " + UTF8ToString(bearer);
+    const opts = { method: "POST", headers, body: form, credentials: "omit", cache: "no-store" };
+    if (typeof AbortSignal !== "undefined" && AbortSignal.timeout) opts.signal = AbortSignal.timeout(30000);
+    fetch(UTF8ToString(url), opts)
+        .then((r) => r.text().then((t) => { req.status = r.status; req.text = t; req.done = true; }))
+        .catch(() => { req.failed = true; req.done = true; });
+    return id;
+});
+
+esp_err_t os_http_upload(const char *url, const char *bearer, const char *path, const void *data, size_t len,
+                         const char *filename, char *resp, size_t cap, int *status)
+{
+    *status = 0;
+    if (cap) {
+        resp[0] = 0;
+    }
+    uint8_t *buf = NULL;
+    if (path) {
+        struct stat st;
+        FILE *f = stat(path, &st) == 0 && S_ISREG(st.st_mode) ? fopen(path, "rb") : NULL;
+        if (!f) {
+            return ESP_ERR_NOT_FOUND;
+        }
+        len = st.st_size;
+        buf = len <= OS_HTTP_UPLOAD_MAX ? malloc(len ? len : 1) : NULL;
+        bool ok = buf && fread(buf, 1, len, f) == len;
+        fclose(f);
+        if (!ok) {
+            free(buf);
+            return len > OS_HTTP_UPLOAD_MAX ? ESP_ERR_INVALID_SIZE : ESP_FAIL;
+        }
+        data = buf;
+    }
+    if (len > OS_HTTP_UPLOAD_MAX) {
+        return ESP_ERR_INVALID_SIZE;
+    }
+    s_requests++;
+    int id = http_js_upload(url, bearer, data, (int)len, filename);
+    free(buf);                          // the Blob holds its own copy
+    int rc;
+    while ((rc = http_js_poll(id, resp, (int)cap, status)) == 0) {
+        vTaskDelay(pdMS_TO_TICKS(20));
+    }
+    if (rc < 0) {
+        ESP_LOGW(TAG, "upload to %s failed", url);
+        return ESP_FAIL;
+    }
+    return ESP_OK;
+}
+
 // The browser keeps its own connections alive: nothing to manage here.
 
 void os_http_tick(void)
