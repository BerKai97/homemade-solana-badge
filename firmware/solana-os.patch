+menu "Badge board"
+
+    config BSP_BOARD_DIY
+        bool "Breadboard build: an ESP32-C5 dev board instead of the badge"
+        default n
+        help
+            For a homemade badge: an ESP32-C5 dev board with an ILI9341 SPI
+            display (CS on GPIO1), a microSD on the display's SD header (or
+            none, see BSP_SD_INTERNAL_FLASH), and six
+            buttons wired from GPIO 2, 5, 23, 24, 25, 26 to GND (Up, Left,
+            Right, Down, Select, Back) instead of the TCA9534 expander. No
+            battery: it reports USB power. Console commands also work on the
+            board's native USB port. Build with sdkconfig.diy (see its header).
+
+    config BSP_SD_INTERNAL_FLASH
+        bool "No microSD: keep /sdcard in the internal flash"
+        depends on BSP_BOARD_DIY
+        default n
+        help
+            Mount a wear-levelled FAT volume from the internal flash's "appfs"
+            partition at /sdcard instead of a microSD card, so apps and data
+            work without a card. No card is probed and the SD CS pin is left
+            alone. Needs a partition table with "appfs" (partitions-diy.csv).
+
+    config BSP_TOUCH_XPT2046
+        bool "XPT2046 resistive touch panel on the display"
+        depends on BSP_BOARD_DIY && BSP_SD_INTERNAL_FLASH
+        select OS_TOUCH
+        default n
+        help
+            The touch controller on the display module, on the shared SPI bus:
+            T_CLK, T_DIN and T_DO on SCK, MOSI and MISO, T_CS and T_IRQ below.
+            Taps, drags and swipes become keys. Without a chip on T_CS the
+            badge boots as before. Needs BSP_SD_INTERNAL_FLASH because the pen
+            interrupt pin is the microSD's CS otherwise.
+
+    config BSP_TOUCH_CS
+        int "Touch CS GPIO"
+        depends on BSP_TOUCH_XPT2046
+        default 6
+
+    config BSP_TOUCH_IRQ
+        int "Touch pen interrupt GPIO (-1: poll)"
+        depends on BSP_TOUCH_XPT2046
+        range -1 28
+        default 4
+
+    config BSP_TOUCH_SPI_HZ
+        int "Touch SPI clock (Hz)"
+        depends on BSP_TOUCH_XPT2046
+        range 100000 2000000
+        default 1000000
+
+endmenu
diff --git a/components/bsp/bsp_sd_flash.c b/components/bsp/bsp_sd_flash.c
new file mode 100644
index 0000000..06992d7
--- /dev/null
+++ b/components/bsp/bsp_sd_flash.c
@@ -0,0 +1,185 @@
+// /sdcard without a card (CONFIG_BSP_SD_INTERNAL_FLASH, breadboard build):
+// a wear-levelled FAT volume in the internal flash's "appfs" partition
+// (partitions-diy.csv), behind the same bsp_sd_* calls as the microSD in
+// bsp_sd.c, so the rest of the firmware sees a mounted card.
+//
+// The volume is formatted on first boot, or whenever it can't be mounted.
+// No card is probed and the SD CS pin is left alone.
+
+#include <stdio.h>
+#include <string.h>
+#include "freertos/FreeRTOS.h"
+#include "freertos/semphr.h"
+#include "esp_check.h"
+#include "esp_log.h"
+#include "esp_partition.h"
+#include "esp_vfs_fat.h"
+#include "wear_levelling.h"
+#include "bsp.h"
+
+static const char *TAG = "bsp_sd";
+
+#define PART_LABEL  "appfs"
+
+static SemaphoreHandle_t s_lock;
+static wl_handle_t s_wl = WL_INVALID_HANDLE;
+static bsp_sd_state_t s_state = BSP_SD_NOT_MOUNTED;
+static esp_err_t s_last_err;
+static uint64_t s_total_bytes, s_free_bytes;
+
+#define LOCK()   xSemaphoreTake(s_lock, portMAX_DELAY)
+#define UNLOCK() xSemaphoreGive(s_lock)
+
+static const esp_vfs_fat_mount_config_t s_cfg = {
+    .format_if_mount_failed = true,
+    .max_files = 5,
+    .allocation_unit_size = 4096,
+};
+
+static const esp_partition_t *part(void)
+{
+    return esp_partition_find_first(ESP_PARTITION_TYPE_DATA, ESP_PARTITION_SUBTYPE_DATA_FAT, PART_LABEL);
+}
+
+static bool ensure_lock(void)
+{
+    if (!s_lock) {
+        s_lock = xSemaphoreCreateMutex();
+    }
+    return s_lock != NULL;
+}
+
+static void update_usage_locked(void)
+{
+    s_total_bytes = s_free_bytes = 0;
+    if (s_state == BSP_SD_MOUNTED) {
+        esp_vfs_fat_info(BSP_SD_MOUNT, &s_total_bytes, &s_free_bytes);
+    }
+}
+
+static esp_err_t mount_locked(void)
+{
+    if (s_state == BSP_SD_MOUNTED) {
+        return ESP_OK;
+    }
+    esp_err_t err = esp_vfs_fat_spiflash_mount_rw_wl(BSP_SD_MOUNT, PART_LABEL, &s_cfg, &s_wl);
+    s_last_err = err;
+    if (err != ESP_OK) {
+        s_wl = WL_INVALID_HANDLE;
+        s_state = BSP_SD_ERROR;
+        ESP_LOGE(TAG, "internal flash FS (partition \"%s\"): %s", PART_LABEL, esp_err_to_name(err));
+        return err;
+    }
+    s_state = BSP_SD_MOUNTED;
+    update_usage_locked();
+    ESP_LOGI(TAG, "internal flash FS mounted at %s: %llu KB, %llu KB free", BSP_SD_MOUNT,
+             s_total_bytes >> 10, s_free_bytes >> 10);
+    return ESP_OK;
+}
+
+static esp_err_t unmount_locked(void)
+{
+    esp_err_t err = ESP_OK;
+    if (s_state == BSP_SD_MOUNTED) {
+        err = esp_vfs_fat_spiflash_unmount_rw_wl(BSP_SD_MOUNT, s_wl);
+    }
+    s_wl = WL_INVALID_HANDLE;
+    s_state = BSP_SD_NOT_MOUNTED;
+    s_total_bytes = s_free_bytes = 0;
+    return err;
+}
+
+esp_err_t bsp_sd_mount(void)
+{
+    ESP_RETURN_ON_ERROR(bsp_spi_bus_init(), TAG, "bus");    // the display's bus, as with a card
+    ESP_RETURN_ON_FALSE(ensure_lock(), ESP_ERR_NO_MEM, TAG, "lock");
+    LOCK();
+    esp_err_t err = mount_locked();
+    UNLOCK();
+    return err;
+}
+
+esp_err_t bsp_sd_unmount(void)
+{
+    if (!ensure_lock()) {
+        return ESP_ERR_NO_MEM;
+    }
+    LOCK();
+    esp_err_t err = unmount_locked();
+    UNLOCK();
+    return err;
+}
+
+// Unmounted around the format, so a failure leaves a clean state to retry.
+esp_err_t bsp_sd_format(void)
+{
+    if (!ensure_lock()) {
+        return ESP_ERR_NO_MEM;
+    }
+    LOCK();
+    ESP_LOGW(TAG, "formatting internal flash FS");
+    unmount_locked();
+    esp_vfs_fat_mount_config_t cfg = s_cfg;
+    esp_err_t err = esp_vfs_fat_spiflash_format_cfg_rw_wl(BSP_SD_MOUNT, PART_LABEL, &cfg);
+    esp_err_t merr = mount_locked();
+    if (err == ESP_OK) {
+        err = merr;
+    } else {
+        s_last_err = err;
+    }
+    UNLOCK();
+    return err;
+}
+
+void bsp_sd_refresh_usage(void)
+{
+    if (!s_lock) {
+        return;
+    }
+    LOCK();
+    update_usage_locked();
+    UNLOCK();
+}
+
+void bsp_sd_get_info(bsp_sd_info_t *out)
+{
+    memset(out, 0, sizeof(*out));
+    if (!s_lock) {
+        out->state = BSP_SD_NOT_MOUNTED;
+        return;
+    }
+    LOCK();
+    out->state = s_state;
+    out->last_err = s_last_err;
+    if (s_state == BSP_SD_MOUNTED) {
+        const esp_partition_t *p = part();
+        strlcpy(out->name, "flash", sizeof(out->name));
+        out->type = "internal";
+        out->card_mb = p ? p->size >> 20 : 0;
+        out->total_bytes = s_total_bytes;
+        out->free_bytes = s_free_bytes;
+    }
+    UNLOCK();
+}
+
+void bsp_sd_print_card(void)
+{
+    const esp_partition_t *p = part();
+    if (!p) {
+        printf("Storage: internal flash, no \"%s\" partition (flash partitions-diy.csv)\n", PART_LABEL);
+        return;
+    }
+    if (!ensure_lock()) {
+        return;
+    }
+    LOCK();
+    update_usage_locked();
+    printf("Storage: internal flash (no microSD), partition \"%s\" at 0x%lx, %lu KB, at %s\n", PART_LABEL,
+           (unsigned long)p->address, (unsigned long)(p->size >> 10), BSP_SD_MOUNT);
+    if (s_state == BSP_SD_MOUNTED) {
+        printf("FAT: %llu KB total, %llu KB free\n", s_total_bytes >> 10, s_free_bytes >> 10);
+    } else {
+        printf("FAT: %s (last error %s)\n", bsp_sd_state_str(s_state), esp_err_to_name(s_last_err));
+    }
+    UNLOCK();
+}
diff --git a/components/bsp/bsp_touch.c b/components/bsp/bsp_touch.c
new file mode 100644
index 0000000..fd699a0
--- /dev/null
+++ b/components/bsp/bsp_touch.c
@@ -0,0 +1,235 @@
+// XPT2046 resistive touch controller on the shared SPI bus (breadboard build,
+// CONFIG_BSP_TOUCH_XPT2046).
+//
+// Each reading is one transaction of 6 X, 6 Y, Z1 and Z2 conversions, taken
+// while the LCD is held (bsp_bus.h). The first X and Y settle the plate and
+// are dropped; the middle 3 of the other 5 are averaged, and a frame whose 3
+// are more than SPREAD_MAX apart is noise. A press needs PRESS_FRAMES good
+// frames in a row and a release RELEASE_FRAMES without pressure; a noisy
+// frame in between is skipped, as a sliding finger gives some. The release
+// reports where the finger was LIFT_BACK frames before it lifted, since the
+// plate reads wild while the pressure fades. The backlight's PWM edges spoil
+// conversions, so its timer is frozen for the ~0.3 ms of a reading.
+//
+// The pen interrupt wakes the task while nothing touches the panel; while it
+// does, the task samples every SAMPLE_MS with the interrupt off. Without an
+// interrupt pin it polls.
+
+#include <stdlib.h>
+#include <string.h>
+#include "freertos/FreeRTOS.h"
+#include "freertos/task.h"
+#include "freertos/semphr.h"
+#include "driver/gpio.h"
+#include "driver/spi_master.h"
+#include "esp_check.h"
+#include "esp_log.h"
+#include "bsp.h"
+#include "bsp_bus.h"
+
+static const char *TAG = "bsp_touch";
+
+#define SAMPLES         6
+#define SPREAD_MAX      30
+#define PRESS_FRAMES    2
+#define RELEASE_FRAMES  2
+#define SAMPLE_MS       10
+#define POLL_MS         33          // no interrupt pin: ~30 Hz
+#define MOVE_MIN        24          // raw units (~2 px) before a move is reported
+#define LIFT_BACK       2           // the release is where the finger was this many good frames earlier
+
+// Commands: start bit, channel, 12-bit, differential. PD = 01 keeps the ADC on
+// and the pen interrupt off between conversions; the last one (PD = 00)
+// powers down and turns the pen interrupt back on.
+#define CMD_X           0xD1
+#define CMD_Y           0x91
+#define CMD_Z1          0xB1
+#define CMD_Z2_LAST     0xC0
+#define CONVERSIONS     (2 * SAMPLES + 2)
+#define XFER_LEN        32          // 2 bytes per conversion + 1, rounded up to whole words
+
+static spi_device_handle_t s_dev;
+static SemaphoreHandle_t s_mx;
+static bsp_touch_cb_t s_cb;
+static volatile uint16_t s_z_min = 400;
+static uint8_t s_tx[XFER_LEN] __attribute__((aligned(4)));
+static uint8_t s_rx[XFER_LEN] __attribute__((aligned(4)));
+
+#if BOARD_TOUCH_IRQ >= 0
+static SemaphoreHandle_t s_irq;
+
+static void IRAM_ATTR pen_isr(void *arg)
+{
+    BaseType_t woken = pdFALSE;
+    xSemaphoreGiveFromISR(s_irq, &woken);
+    portYIELD_FROM_ISR(woken);
+}
+#endif
+
+static void sort(uint16_t *v, int n)
+{
+    for (int i = 1; i < n; i++) {
+        for (int j = i; j > 0 && v[j - 1] > v[j]; j--) {
+            uint16_t t = v[j];
+            v[j] = v[j - 1];
+            v[j - 1] = t;
+        }
+    }
+}
+
+// Middle 3 of samples 1..SAMPLES-1; false when they spread too far.
+static bool filter(uint16_t *v, uint16_t *out)
+{
+    sort(v + 1, SAMPLES - 1);
+    uint16_t *m = v + 1 + (SAMPLES - 1 - 3) / 2;
+    *out = (m[0] + m[1] + m[2] + 1) / 3;
+    return m[2] - m[0] <= SPREAD_MAX;
+}
+
+static void read_frame(bsp_touch_raw_t *f)
+{
+    uint16_t v[CONVERSIONS];
+    xSemaphoreTake(s_mx, portMAX_DELAY);
+    memset(s_tx, 0, sizeof(s_tx));
+    for (int i = 0; i < CONVERSIONS; i++) {
+        s_tx[2 * i] = i < SAMPLES ? CMD_X : i < 2 * SAMPLES ? CMD_Y : i == 2 * SAMPLES ? CMD_Z1 : CMD_Z2_LAST;
+    }
+    spi_transaction_t t = { .length = XFER_LEN * 8, .tx_buffer = s_tx, .rx_buffer = s_rx };
+    bsp_lcd_hold();
+    bsp_backlight_freeze(true);
+    spi_device_polling_transmit(s_dev, &t);
+    bsp_backlight_freeze(false);
+    bsp_lcd_release();
+    // Each result is clocked out over the 16 bits after its command, overlapping the next command.
+    for (int i = 0; i < CONVERSIONS; i++) {
+        v[i] = (((s_rx[2 * i + 1] << 8) | s_rx[2 * i + 2]) >> 3) & 0xFFF;
+    }
+    xSemaphoreGive(s_mx);
+    f->z1 = v[2 * SAMPLES];
+    f->z2 = v[2 * SAMPLES + 1];
+    f->z = f->z1 + 4095 - f->z2;
+    bool x_ok = filter(v, &f->x), y_ok = filter(v + SAMPLES, &f->y);
+    f->down = f->z1 > 0 && f->z >= s_z_min;
+    f->ok = f->down && x_ok && y_ok;
+}
+
+// No chip: MISO's pull-up reads every bit as 1.
+static bool chip_absent(void)
+{
+    bsp_touch_raw_t f;
+    for (int i = 0; i < 3; i++) {
+        read_frame(&f);
+        if (f.z1 < 4095 || f.z2 < 4095 || f.x < 4095 || f.y < 4095) {
+            return false;
+        }
+    }
+    return true;
+}
+
+// Until the pen interrupt fires, or one poll period.
+static void wait_idle(void)
+{
+#if BOARD_TOUCH_IRQ >= 0
+    xSemaphoreTake(s_irq, 0);               // a stale edge from the last conversions
+    gpio_intr_enable(BOARD_TOUCH_IRQ);
+    if (gpio_get_level(BOARD_TOUCH_IRQ)) {
+        xSemaphoreTake(s_irq, portMAX_DELAY);
+    }
+    gpio_intr_disable(BOARD_TOUCH_IRQ);
+#else
+    vTaskDelay(pdMS_TO_TICKS(POLL_MS));
+#endif
+}
+
+static void touch_task(void *arg)
+{
+    bsp_touch_raw_t hist[LIFT_BACK + 1];    // recent good frames, newest first
+    int nhist = 0, good = 0, bad = 0;
+    bool down = false;
+    uint16_t lx = 0, ly = 0;                // last position reported
+    for (;;) {
+        if (!down && !good) {
+            wait_idle();
+        }
+        bsp_touch_raw_t f;
+        read_frame(&f);
+        if (f.ok) {
+            memmove(hist + 1, hist, sizeof(hist) - sizeof(hist[0]));
+            hist[0] = f;
+            nhist += nhist <= LIFT_BACK;
+            bad = 0;
+            if (!down && ++good >= PRESS_FRAMES) {
+                down = true;
+                lx = f.x;
+                ly = f.y;
+                s_cb(BSP_TOUCH_PRESS, f.x, f.y);
+            } else if (down && abs(f.x - lx) + abs(f.y - ly) >= MOVE_MIN) {
+                lx = f.x;
+                ly = f.y;
+                s_cb(BSP_TOUCH_MOVE, f.x, f.y);
+            }
+        } else if (!down) {
+            good = nhist = 0;
+        } else if (!f.down && ++bad >= RELEASE_FRAMES) {
+            const bsp_touch_raw_t *at = &hist[nhist - 1 < LIFT_BACK ? nhist - 1 : LIFT_BACK];
+            down = false;
+            good = bad = nhist = 0;
+            s_cb(BSP_TOUCH_RELEASE, at->x, at->y);
+            continue;
+        }
+        vTaskDelay(pdMS_TO_TICKS(SAMPLE_MS));
+    }
+}
+
+esp_err_t bsp_touch_start(bsp_touch_cb_t cb, uint16_t z_min)
+{
+    ESP_RETURN_ON_FALSE(cb && !s_dev, ESP_ERR_INVALID_STATE, TAG, "started");
+    ESP_RETURN_ON_ERROR(bsp_spi_bus_init(), TAG, "bus");
+    s_z_min = z_min;
+    spi_device_interface_config_t cfg = {
+        .clock_speed_hz = CONFIG_BSP_TOUCH_SPI_HZ,
+        .mode = 0,
+        .spics_io_num = BOARD_TOUCH_CS,
+        .queue_size = 1,
+    };
+    ESP_RETURN_ON_ERROR(spi_bus_add_device(BOARD_SPI_HOST, &cfg, &s_dev), TAG, "touch device");
+    s_mx = xSemaphoreCreateMutex();
+    if (chip_absent()) {
+        spi_bus_remove_device(s_dev);
+        s_dev = NULL;
+        ESP_LOGI(TAG, "no XPT2046 on CS %d", BOARD_TOUCH_CS);
+        return ESP_ERR_NOT_FOUND;
+    }
+    s_cb = cb;
+#if BOARD_TOUCH_IRQ >= 0
+    gpio_config_t io = {
+        .pin_bit_mask = BIT64(BOARD_TOUCH_IRQ),
+        .mode = GPIO_MODE_INPUT,
+        .pull_up_en = GPIO_PULLUP_ENABLE,
+        .intr_type = GPIO_INTR_NEGEDGE,
+    };
+    ESP_RETURN_ON_ERROR(gpio_config(&io), TAG, "irq gpio");
+    gpio_intr_disable(BOARD_TOUCH_IRQ);
+    s_irq = xSemaphoreCreateBinary();
+    esp_err_t err = gpio_install_isr_service(0);
+    ESP_RETURN_ON_FALSE(err == ESP_OK || err == ESP_ERR_INVALID_STATE, err, TAG, "isr service");
+    ESP_RETURN_ON_ERROR(gpio_isr_handler_add(BOARD_TOUCH_IRQ, pen_isr, NULL), TAG, "isr");
+#endif
+    xTaskCreate(touch_task, "touch", 3072, NULL, 5, NULL);
+    ESP_LOGI(TAG, "XPT2046 on CS %d, %s", BOARD_TOUCH_CS, BOARD_TOUCH_IRQ >= 0 ? "pen interrupt" : "polled");
+    return ESP_OK;
+}
+
+bool bsp_touch_raw(bsp_touch_raw_t *out)
+{
+    if (!s_dev) {
+        return false;
+    }
+    read_frame(out);
+    return true;
+}
+
+void bsp_touch_set_threshold(uint16_t z_min)
+{
+    s_z_min = z_min;
+}
diff --git a/main/core/os_touch.c b/main/core/os_touch.c
new file mode 100644
index 0000000..84b2ad2
--- /dev/null
+++ b/main/core/os_touch.c
@@ -0,0 +1,347 @@
+// Touch input: the panel's points (bsp_touch.c) become taps, drags and
+// swipes on the OS task, and those become keys, so apps need nothing new.
+//   tap                 the object under the finger answers (ui.h tap
+//                       targets), else SELECT
+//   vertical drag       a key every DRAG_STEP px, finger up = DOWN
+//   swipe right from    BACK
+//   the left edge
+//   other swipes        offered to the object under the start, else
+//                       LEFT / RIGHT (finger left = RIGHT)
+// The confirm dialog takes every touch while it is open (os.c). The
+// calibration screen (touchcal.c) gets the raw points instead.
+//
+// Console: "touch" (see cmd_touch). Its taps and swipes are synthetic: they
+// work without a panel, and never approve a confirm dialog.
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "freertos/FreeRTOS.h"
+#include "freertos/task.h"
+#include "esp_log.h"
+#include "esp_timer.h"
+#include "nvs.h"
+#include "bsp.h"
+#include "os.h"
+#include "os_cmd.h"
+#include "os_touch.h"
+#include "ui.h"
+
+static const char *TAG = "touch";
+
+#define TAP_SLOP        10      // px a tap may wander
+#define DRAG_STEP       24
+#define EDGE_W          30      // a back swipe starts this close to the left edge
+#define SWIPE_MIN       50
+#define Z_DEFAULT       150     // idle reads z1 = 0; a hard press reads ~800 on a panel's weak side
+#define POST_TRIES      20
+
+static bool s_present, s_on = true, s_have_cal;
+static int32_t s_cal[6];
+static uint16_t s_z_min = Z_DEFAULT;
+
+// Written by the touch task, read anywhere.
+static volatile bool s_live_down, s_move_pending;
+static volatile uint16_t s_live_rx, s_live_ry;
+
+// The gesture in progress (OS task).
+static struct {
+    bool down, synthetic, dialog;
+    enum { G_NONE, G_VERT, G_HORIZ } mode;
+    int x0, y0, sent;
+} g;
+
+static bool map(int rx, int ry, int *x, int *y)
+{
+    if (!s_have_cal) {
+        return false;
+    }
+    int64_t sx = ((int64_t)s_cal[0] * rx + (int64_t)s_cal[1] * ry + s_cal[2] + 32768) >> 16;
+    int64_t sy = ((int64_t)s_cal[3] * rx + (int64_t)s_cal[4] * ry + s_cal[5] + 32768) >> 16;
+    *x = sx < 0 ? 0 : sx >= BOARD_LCD_H_RES ? BOARD_LCD_H_RES - 1 : (int)sx;
+    *y = sy < 0 ? 0 : sy >= BOARD_LCD_V_RES ? BOARD_LCD_V_RES - 1 : (int)sy;
+    return true;
+}
+
+bool os_touch_live(int *x, int *y)
+{
+    return s_on && s_live_down && map(s_live_rx, s_live_ry, x, y);
+}
+
+// ---------------------------------------------------------------------------
+// Gestures (OS task, LVGL locked)
+
+// Offer a tap (swipe 0) or a swipe to the object under (x, y) and its
+// parents; then press the keys it answered with, or the default.
+static void tap(int x, int y, int swipe)
+{
+    ui_tap_t t = { .p = { x, y }, .swipe = swipe };
+    lv_obj_t *o = lv_indev_search_obj(lv_layer_top(), &t.p);
+    if (!o) {
+        o = lv_indev_search_obj(lv_screen_active(), &t.p);
+    }
+    for (; o && !t.handled; o = lv_obj_get_parent(o)) {
+        lv_obj_send_event(o, ui_tap_event(), &t);
+    }
+    if (!t.handled) {
+        ui_tap_add(&t, swipe > 0 ? OS_KEY_RIGHT : swipe < 0 ? OS_KEY_LEFT : OS_KEY_SELECT);
+    }
+    for (int i = 0; i < t.n; i++) {
+        os_touch_key(t.keys[i], false);
+    }
+}
+
+static void gesture(os_touch_phase_t ph, int x, int y, bool synthetic)
+{
+    if (ph == OS_TOUCH_PRESS) {
+        g.down = true;
+        g.synthetic = synthetic;
+        g.dialog = false;
+        g.mode = G_NONE;
+        g.x0 = x;
+        g.y0 = y;
+        g.sent = 0;
+    } else if (!g.down || g.synthetic != synthetic) {
+        return;                                 // the other source's gesture
+    }
+    // Once the dialog has seen part of a gesture, the rest is the dialog's:
+    // lifting the finger after approving must not tap the app.
+    if (os_confirm_touch(ph, x, y, synthetic) || g.dialog) {
+        g.dialog = true;
+        g.down = ph != OS_TOUCH_RELEASE;
+        return;
+    }
+    int dx = x - g.x0, dy = y - g.y0;
+    if (g.mode == G_NONE && (abs(dx) > TAP_SLOP || abs(dy) > TAP_SLOP)) {
+        g.mode = abs(dy) > abs(dx) ? G_VERT : G_HORIZ;
+    }
+    if (g.mode == G_VERT) {
+        int steps = -dy / DRAG_STEP;
+        for (; g.sent < steps; g.sent++) {
+            os_touch_key(OS_KEY_DOWN, true);    // repeat: lists stop at the ends instead of wrapping
+        }
+        for (; g.sent > steps; g.sent--) {
+            os_touch_key(OS_KEY_UP, true);
+        }
+    }
+    if (ph != OS_TOUCH_RELEASE) {
+        return;
+    }
+    g.down = false;
+    if (g.mode == G_NONE) {
+        tap(g.x0, g.y0, 0);
+    } else if (g.mode == G_HORIZ && abs(dx) >= SWIPE_MIN) {
+        if (g.x0 < EDGE_W && dx > 0) {
+            os_touch_key(OS_KEY_BACK, false);
+        } else {
+            tap(g.x0, g.y0, dx < 0 ? 1 : -1);
+        }
+    }
+}
+
+// A point, packed into os_post's argument: phase, synthetic flag, x and y
+// (raw for the panel, screen coordinates for the console).
+#define PACK(ph, syn, x, y) ((void *)(uintptr_t)((ph) | (syn) << 2 | (uint32_t)(x) << 3 | (uint32_t)(y) << 16))
+
+static void posted(void *arg)
+{
+    uint32_t v = (uintptr_t)arg;
+    os_touch_phase_t ph = v & 3;
+    bool synthetic = v >> 2 & 1;
+    int x = v >> 3 & 0x1FFF, y = v >> 16 & 0x1FFF;
+    if (ph == OS_TOUCH_MOVE && !synthetic) {
+        s_move_pending = false;
+        x = s_live_rx;                          // the latest point, not the one posted
+        y = s_live_ry;
+    }
+    if (os_current() == &os_touchcal) {
+        if (!synthetic) {
+            touchcal_point(ph, x, y);
+        }
+        return;
+    }
+    if (!synthetic && (!s_on || !map(x, y, &x, &y))) {
+        return;                                 // off, or not calibrated yet
+    }
+    gesture(ph, x, y, synthetic);
+}
+
+// Press and release must arrive: wait for room in the OS queue.
+static void post(os_touch_phase_t ph, bool synthetic, int x, int y)
+{
+    for (int i = 0; i < POST_TRIES; i++) {
+        if (os_post(posted, PACK(ph, synthetic, x, y))) {
+            return;
+        }
+        vTaskDelay(pdMS_TO_TICKS(5));
+    }
+    ESP_LOGW(TAG, "dropped a touch event: OS queue full");
+}
+
+// Touch task. Moves are coalesced: at most one waits in the OS queue.
+static void on_touch(bsp_touch_ev_t ev, uint16_t rx, uint16_t ry)
+{
+    s_live_rx = rx;
+    s_live_ry = ry;
+    switch (ev) {
+    case BSP_TOUCH_PRESS:
+        s_live_down = true;
+        post(OS_TOUCH_PRESS, false, rx, ry);
+        break;
+    case BSP_TOUCH_MOVE:
+        if (!s_move_pending) {
+            s_move_pending = true;
+            if (!os_post(posted, PACK(OS_TOUCH_MOVE, 0, rx, ry))) {
+                s_move_pending = false;
+            }
+        }
+        break;
+    case BSP_TOUCH_RELEASE:
+        s_live_down = false;
+        post(OS_TOUCH_RELEASE, false, rx, ry);
+        break;
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Settings in NVS "input": touchcal (6 x int32), touchz (u16), touchoff (u8)
+
+static void load(void)
+{
+    nvs_handle_t h;
+    if (nvs_open("input", NVS_READONLY, &h) != ESP_OK) {
+        return;
+    }
+    size_t len = sizeof(s_cal);
+    s_have_cal = nvs_get_blob(h, "touchcal", s_cal, &len) == ESP_OK && len == sizeof(s_cal);
+    uint16_t z;
+    if (nvs_get_u16(h, "touchz", &z) == ESP_OK) {
+        s_z_min = z;
+    }
+    uint8_t off;
+    if (nvs_get_u8(h, "touchoff", &off) == ESP_OK) {
+        s_on = !off;
+    }
+    nvs_close(h);
+}
+
+static void save(void)
+{
+    nvs_handle_t h;
+    if (nvs_open("input", NVS_READWRITE, &h) != ESP_OK) {
+        return;
+    }
+    if (s_have_cal) {
+        nvs_set_blob(h, "touchcal", s_cal, sizeof(s_cal));
+    } else {
+        nvs_erase_key(h, "touchcal");
+    }
+    nvs_set_u16(h, "touchz", s_z_min);
+    nvs_set_u8(h, "touchoff", !s_on);
+    nvs_commit(h);
+    nvs_close(h);
+}
+
+void os_touch_cal_save(const int32_t cal[6])
+{
+    memcpy(s_cal, cal, sizeof(s_cal));
+    s_have_cal = true;
+    save();
+    ESP_LOGI(TAG, "calibrated: x = %ld %ld %ld, y = %ld %ld %ld (/65536)", (long)cal[0], (long)cal[1],
+             (long)cal[2], (long)cal[3], (long)cal[4], (long)cal[5]);
+}
+
+// ---------------------------------------------------------------------------
+// Console
+
+static void print_status(void)
+{
+    printf("touch: %s, %s, threshold %u, %s\n", s_present ? "XPT2046 found" : "no panel", s_on ? "on" : "off",
+           s_z_min, s_have_cal ? "calibrated" : "not calibrated");
+    if (s_have_cal) {
+        printf("  x = (%ld*rx + %ld*ry + %ld) / 65536\n  y = (%ld*rx + %ld*ry + %ld) / 65536\n", (long)s_cal[0],
+               (long)s_cal[1], (long)s_cal[2], (long)s_cal[3], (long)s_cal[4], (long)s_cal[5]);
+    }
+}
+
+static void watch(int seconds)
+{
+    if (!s_present) {
+        printf("touch: no panel\n");
+        return;
+    }
+    printf("frames touched (z1 > 0), every 10 ms for %d s: ms, raw x, y, z1, z2, pressure (threshold %u) -> "
+           "screen x, y\n", seconds, s_z_min);
+    int64_t t0 = esp_timer_get_time();
+    for (int64_t t = 0; t < seconds * 1000000LL; t = esp_timer_get_time() - t0) {
+        bsp_touch_raw_t r;
+        bsp_touch_raw(&r);
+        if (r.z1) {
+            int x = -1, y = -1;
+            map(r.x, r.y, &x, &y);
+            printf("%5lld %4u %4u  z1 %4u z2 %4u  z %4u %-5s -> %d, %d\n", t / 1000, r.x, r.y, r.z1, r.z2, r.z,
+                   r.ok ? "DOWN" : r.down ? "noisy" : "", x, y);
+        }
+        vTaskDelay(pdMS_TO_TICKS(10));
+    }
+}
+
+static bool screen_point(char **argv, int *x, int *y)
+{
+    *x = atoi(argv[0]);
+    *y = atoi(argv[1]);
+    return *x >= 0 && *x < BOARD_LCD_H_RES && *y >= 0 && *y < BOARD_LCD_V_RES;
+}
+
+static int cmd_touch(int argc, char **argv)
+{
+    const char *sub = argc > 1 ? argv[1] : "";
+    int x1, y1, x2, y2;
+    if (!sub[0]) {
+        print_status();
+    } else if (!strcmp(sub, "watch")) {
+        watch(argc > 2 ? atoi(argv[2]) : 10);
+    } else if (!strcmp(sub, "cal") && argc == 2) {
+        os_launch(&os_touchcal);
+    } else if (!strcmp(sub, "cal") && argc == 3 && !strcmp(argv[2], "clear")) {
+        s_have_cal = false;
+        save();
+        printf("touch: calibration cleared; touches are ignored until 'touch cal'\n");
+    } else if (!strcmp(sub, "thresh") && argc == 3 && atoi(argv[2]) > 0 && atoi(argv[2]) < 8190) {
+        s_z_min = atoi(argv[2]);
+        bsp_touch_set_threshold(s_z_min);
+        save();
+        print_status();
+    } else if ((!strcmp(sub, "on") || !strcmp(sub, "off")) && argc == 2) {
+        s_on = !strcmp(sub, "on");
+        save();
+        print_status();
+    } else if (!strcmp(sub, "tap") && argc == 4 && screen_point(argv + 2, &x1, &y1)) {
+        post(OS_TOUCH_PRESS, true, x1, y1);
+        vTaskDelay(pdMS_TO_TICKS(60));
+        post(OS_TOUCH_RELEASE, true, x1, y1);
+    } else if (!strcmp(sub, "swipe") && argc == 6 && screen_point(argv + 2, &x1, &y1)
+               && screen_point(argv + 4, &x2, &y2)) {
+        post(OS_TOUCH_PRESS, true, x1, y1);
+        for (int i = 1; i <= 8; i++) {
+            vTaskDelay(pdMS_TO_TICKS(20));
+            post(i < 8 ? OS_TOUCH_MOVE : OS_TOUCH_RELEASE, true, x1 + (x2 - x1) * i / 8, y1 + (y2 - y1) * i / 8);
+        }
+    } else {
+        printf("usage: touch [watch [s] | cal [clear] | thresh <n> | on | off | tap <x> <y> | "
+               "swipe <x1> <y1> <x2> <y2>]\n");
+        return 1;
+    }
+    return 0;
+}
+
+void os_touch_start(void)
+{
+    load();
+    os_cmd_register("touch", "touch [watch [s]|cal [clear]|thresh <n>|on|off|tap <x> <y>|swipe <x1> <y1> <x2> <y2>]",
+                    cmd_touch);
+    s_present = bsp_touch_start(on_touch, s_z_min) == ESP_OK;
+    if (s_present && !s_have_cal) {
+        os_launch(&os_touchcal);                // first boot with a panel
+    }
+}
diff --git a/main/core/os_touch.h b/main/core/os_touch.h
new file mode 100644
index 0000000..1124565
--- /dev/null
+++ b/main/core/os_touch.h
@@ -0,0 +1,29 @@
+#pragma once
+
+// Touch input (CONFIG_OS_TOUCH): os_touch.c turns the panel's points into
+// keys and taps on the OS task; touchcal.c is the calibration screen. Apps
+// don't use this: they get keys, and ui.h's tap targets.
+
+#include <stdbool.h>
+#include <stdint.h>
+#include "os.h"
+
+typedef enum { OS_TOUCH_PRESS, OS_TOUCH_MOVE, OS_TOUCH_RELEASE } os_touch_phase_t;
+
+extern const os_app_t os_touchcal;      // hidden system app, "open touchcal"
+
+void os_touch_start(void);              // os_start(): probe the panel, register "touch"
+
+// Finger on the panel now (not console-injected), in screen coordinates. Any task.
+bool os_touch_live(int *x, int *y);
+
+// Calibration: screen = (a*rx + b*ry + c) / 65536 for x, (d*rx + e*ry + f) / 65536 for y.
+void os_touch_cal_save(const int32_t cal[6]);
+
+// os.c, OS task: a key from a gesture (never answers the confirm dialog),
+// and the dialog's own touch targets (true: the dialog is open and took it).
+void os_touch_key(os_key_t key, bool repeat);
+bool os_confirm_touch(os_touch_phase_t ph, int x, int y, bool synthetic);
+
+// touchcal.c, OS task: raw points while the calibration screen is open.
+void touchcal_point(os_touch_phase_t ph, int rx, int ry);
diff --git a/main/core/touchcal.c b/main/core/touchcal.c
new file mode 100644
index 0000000..a171b8e
--- /dev/null
+++ b/main/core/touchcal.c
@@ -0,0 +1,194 @@
+// Touch calibration: a cross at three points, then a fourth to check the
+// fit. The fit is affine (x = a*rx + b*ry + c, same for y), which covers the
+// panel being swapped, mirrored or a little skewed against the display. It
+// starts over when the check misses by more than CHECK_MAX px. BOOT or
+// CANCEL aborts. Opens by itself on the first boot with a panel.
+
+#include <stdlib.h>
+#include <string.h>
+#include "esp_timer.h"
+#include "os.h"
+#include "os_touch.h"
+#include "ui.h"
+
+#define POINTS      3
+#define CHECK_MAX   8           // px
+#define STILL_MAX   200         // raw: a press that slides further is redone
+#define CROSS       21
+
+static const int16_t s_target[POINTS + 1][2] = { {32, 32}, {288, 120}, {160, 216}, {64, 200} };
+
+static lv_obj_t *s_cross, *s_prompt, *s_step;
+static int s_cur;
+static int32_t s_raw[POINTS][2], s_cal[6];
+static int32_t s_sum[2], s_min[2], s_max[2], s_n;     // this press; s_n -1: none yet
+static int64_t s_done_at;
+
+static void render(void)
+{
+    if (s_cur > POINTS) {
+        lv_obj_set_hidden(s_cross, true);
+        lv_label_set_text(s_prompt, "Saved");
+        lv_label_set_text(s_step, "Touch calibrated");
+        return;
+    }
+    lv_obj_set_pos(s_cross, s_target[s_cur][0] - CROSS / 2, s_target[s_cur][1] - CROSS / 2);
+    lv_label_set_text(s_prompt, s_cur < POINTS ? "Tap the cross" : "Once more");
+    if (s_cur < POINTS) {
+        lv_label_set_text_fmt(s_step, "Point %d of %d: press, hold still, lift", s_cur + 1, POINTS);
+    } else {
+        lv_label_set_text(s_step, "Checking the fit");
+    }
+}
+
+static lv_obj_t *line(lv_obj_t *parent, int x, int y, int w, int h)
+{
+    lv_obj_t *l = lv_obj_create(parent);
+    lv_obj_remove_style_all(l);
+    lv_obj_set_pos(l, x, y);
+    lv_obj_set_size(l, w, h);
+    lv_obj_set_style_bg_opa(l, LV_OPA_COVER, 0);
+    lv_obj_set_style_bg_color(l, ui_col(COL_GREEN), 0);
+    return l;
+}
+
+static void enter(lv_obj_t *root)
+{
+    s_cur = 0;
+    s_n = -1;
+    s_done_at = 0;
+    s_prompt = ui_label(root, &sol_font_20, COL_TEXT, "");
+    lv_obj_align(s_prompt, LV_ALIGN_CENTER, 0, -14);
+    s_step = ui_label(root, &sol_mono_12, COL_DIM, "");
+    lv_obj_align(s_step, LV_ALIGN_CENTER, 0, 12);
+    ui_hint(root, "BOOT or CANCEL to skip");
+    // Over everything, in screen coordinates (the status bar too).
+    s_cross = lv_obj_create(lv_layer_top());
+    lv_obj_remove_style_all(s_cross);
+    lv_obj_set_size(s_cross, CROSS, CROSS);
+    line(s_cross, CROSS / 2, 0, 1, CROSS);
+    line(s_cross, 0, CROSS / 2, CROSS, 1);
+    render();
+}
+
+static void leave(void)
+{
+    lv_obj_delete(s_cross);
+    s_cross = NULL;
+}
+
+static int64_t det3(int64_t a, int64_t b, int64_t c, int64_t d, int64_t e, int64_t f, int64_t g, int64_t h,
+                    int64_t i)
+{
+    return a * (e * i - f * h) - b * (d * i - f * g) + c * (d * h - e * g);
+}
+
+// Solves a*rx + b*ry + c = target at the three points, x then y, by
+// Cramer's rule, in 1/65536. false: the points are (nearly) on a line.
+static bool solve(void)
+{
+    const int32_t (*r)[2] = s_raw;
+    int64_t det = det3(r[0][0], r[0][1], 1, r[1][0], r[1][1], 1, r[2][0], r[2][1], 1);
+    if (llabs(det) < 1000) {
+        return false;
+    }
+    for (int k = 0; k < 2; k++) {
+        int64_t t0 = s_target[0][k], t1 = s_target[1][k], t2 = s_target[2][k];
+        int64_t a = det3(t0, r[0][1], 1, t1, r[1][1], 1, t2, r[2][1], 1);
+        int64_t b = det3(r[0][0], t0, 1, r[1][0], t1, 1, r[2][0], t2, 1);
+        int64_t c = det3(r[0][0], r[0][1], t0, r[1][0], r[1][1], t1, r[2][0], r[2][1], t2);
+        s_cal[3 * k] = (int32_t)(a * 65536 / det);
+        s_cal[3 * k + 1] = (int32_t)(b * 65536 / det);
+        s_cal[3 * k + 2] = (int32_t)(c * 65536 / det);
+    }
+    return true;
+}
+
+static void restart(const char *why, int px)
+{
+    os_toast(why, px);
+    s_cur = 0;
+    render();
+}
+
+// One finished press at its average raw point.
+static void point(int rx, int ry)
+{
+    if (s_cur < POINTS) {
+        s_raw[s_cur][0] = rx;
+        s_raw[s_cur][1] = ry;
+        if (++s_cur == POINTS && !solve()) {
+            restart("Those points were too close together. Again", 0);
+            return;
+        }
+        render();
+        return;
+    }
+    int x = (int)(((int64_t)s_cal[0] * rx + (int64_t)s_cal[1] * ry + s_cal[2]) >> 16);
+    int y = (int)(((int64_t)s_cal[3] * rx + (int64_t)s_cal[4] * ry + s_cal[5]) >> 16);
+    int dx = x - s_target[POINTS][0], dy = y - s_target[POINTS][1];
+    if (dx * dx + dy * dy > CHECK_MAX * CHECK_MAX) {
+        int off = abs(dx) > abs(dy) ? abs(dx) : abs(dy);
+        restart("That was %d px off. Once more from the start", off);
+        return;
+    }
+    os_touch_cal_save(s_cal);
+    s_cur++;
+    s_done_at = esp_timer_get_time();
+    render();
+}
+
+void touchcal_point(os_touch_phase_t ph, int rx, int ry)
+{
+    if (s_cur > POINTS) {
+        return;
+    }
+    if (ph == OS_TOUCH_PRESS) {
+        s_n = 0;
+        s_sum[0] = s_sum[1] = 0;
+        s_min[0] = s_min[1] = 4095;
+        s_max[0] = s_max[1] = 0;
+    }
+    if (s_n < 0) {
+        return;                         // a touch from before this screen opened
+    }
+    int v[2] = { rx, ry };
+    for (int k = 0; k < 2; k++) {
+        s_sum[k] += v[k];
+        s_min[k] = v[k] < s_min[k] ? v[k] : s_min[k];
+        s_max[k] = v[k] > s_max[k] ? v[k] : s_max[k];
+    }
+    s_n++;
+    if (ph != OS_TOUCH_RELEASE) {
+        return;
+    }
+    int n = s_n;
+    s_n = -1;
+    if (s_max[0] - s_min[0] > STILL_MAX || s_max[1] - s_min[1] > STILL_MAX) {
+        os_toast("Hold still on the cross");
+        return;
+    }
+    point(s_sum[0] / n, s_sum[1] / n);
+}
+
+static bool on_key(os_key_t key, bool repeat)
+{
+    return key != OS_KEY_BACK;          // CANCEL leaves (to the launcher), the rest does nothing
+}
+
+static void on_tick(void)
+{
+    if (s_done_at && esp_timer_get_time() - s_done_at > 1500000) {
+        s_done_at = 0;
+        os_launch(&os_launcher);
+    }
+}
+
+const os_app_t os_touchcal = {
+    .id = "touchcal",
+    .name = "Calibrate touch",
+    .on_enter = enter,
+    .on_exit = leave,
+    .on_key = on_key,
+    .on_tick = on_tick,
+};
